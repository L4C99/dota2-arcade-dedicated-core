{
  "schemaVersion": "draft-2",
  "name": "example",
  "executable": "C:/Games/Dota2/game/bin/win64/dota2.exe",
  "workingDirectory": "C:/Games/Dota2/game",
  "arguments": [
    "-dedicated",
    "-allow_no_lobby_connect",
    "-ip",
    "0.0.0.0",
    "-port",
    "{{game_port}}",
    "-con_logfile",
    "{{log_path}}",
    "+exec",
    "{{cfg_name}}"
  ],
  "cfg": {
    "directory": "C:/Games/Dota2/game/dota/cfg",
    "lines": [
      "hostname \"{{instance_id}}\"",
      "map example_map gamemode=15 customgamemode=\"sample_addon.vpk\" nomapvalidation=1",
      "sv_hibernate_when_empty 0"
    ]
  }
}
